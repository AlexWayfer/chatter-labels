{
	"name": "Chatter Labels for Twitch",
	"description": "Labels for chatters on Twitch",
	"version": "0.1",
	"manifest_version": 3,
	"icons": {
		"512": "images/icons/512.png"
	},
	"permissions": ["storage"],
	"background": {
		"service_worker": "scripts/service-worker.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": ["https://*.twitch.tv/*"],
			"js": [
				"scripts/content/loader.js"
			],
			"css": [
				"styles/content.css"
			]
		}
	],
	"web_accessible_resources": [
		{
			"matches": ["https://*.twitch.tv/*"],
			"resources": [
				"pages/content/**",
				"scripts/logger.js",
				"scripts/models/**",
				"scripts/storage.js",
				"scripts/twitch/**",
				"scripts/content/**"
			]
		}
	],
	"options_ui": {
		"page": "pages/options.html",
		"open_in_tab": true
	}
}
