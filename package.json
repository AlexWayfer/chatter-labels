{
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@stylistic/stylelint-config": "^5.0.0",
		"@stylistic/stylelint-plugin": "^5.2.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.4.0",
		"globals": "^17.6.0",
		"jsdom": "^31.0.0",
		"npm-run-all2": "^9.0.0",
		"playwright": "^1.64.1",
		"remark-cli": "^12.0.1",
		"remark-gfm": "^4.0.1",
		"remark-lint-list-item-indent": "^4.0.1",
		"remark-preset-lint-recommended": "^7.0.1",
		"stylelint": "^17.12.0",
		"stylelint-config-standard": "^40.0.0",
		"zip-a-folder": "^7.0.0"
	},
	"scripts": {
		"postinstall": "pnpm prepare:assets",
		"prepare:assets": "pnpm prepare:styles && pnpm prepare:code-editor",
		"prepare:styles": "node exe/prepare-styles.js",
		"prepare:code-editor": "node exe/prepare-code-editor.js",
		"screenshots": "pnpm prepare:assets && node exe/screenshots.js",
		"test": "node --test",
		"lint:docs": "remark -f .",
		"lint:styles": "stylelint styles/",
		"lint:scripts": "eslint",
		"lint": "pnpm npm-run-all lint:*",
		"pack": "pnpm prepare:assets && node exe/pack.js",
		"release": "node exe/release.js"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@lezer/highlight": "^1.2.5",
		"beercss": "5.0.3"
	}
}
